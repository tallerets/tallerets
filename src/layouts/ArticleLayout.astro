---
import LinkList from '../components/LinkList.astro'
import Footer from '../components/Footer.astro'
import Header from '../components/Header/Header.astro'
import BaseLayout from './BaseLayout.astro'
import Galeria from '../components/Galeria.astro'
import { getLangFromUrl } from '../utils'

const { section } = Astro.props
const { Content } = await section.render()
const { title, desc, links, fotoAmple, fotos, fotosComunitat, entitats } = section.data
const lang = getLangFromUrl(Astro.url)
const credit = 'Foto: Montserrat Coloma'
const altEspai = lang === 'es' ? 'El espacio Tallerets' : "L'espai Tallerets"
---

<BaseLayout title={title} description={desc}>
  <Header />
  <main>
    <section class="page-padding mx-auto pb-20 pt-4 flex flex-col items-center">
      {
        title && (
          <h1 class="text-4xl md:text-6xl text-center md:leading-tight font-[500] max-w-[20ch] mt-0 mb-8 md:mb-12">
            {title}
            <span>
              <img
                width="48"
                height="48"
                class="w-12 inline text-sm"
                src="/icons/flor.svg"
                alt=""
              />
            </span>
          </h1>
        )
      }

      <div class="fitxa content markdown max-w-[65ch]">
          <Content />
      </div>

      {links && <LinkList links={links} />}

      {
        entitats && entitats.length > 0 && (
          <section class="mt-20 w-full max-w-4xl text-center">
            <h2 class="text-3xl font-[500] md:text-4xl">
              {lang === 'es' ? 'Han confiado en nosotras' : 'Han confiat en nosaltres'}
            </h2>
            <ul class="mt-8 flex flex-wrap items-center justify-center gap-4">
              {entitats.map((e: { nom: string; logo?: string }) => (
                <li class="flex h-24 min-w-[10rem] items-center justify-center rounded-xl border-2 border-dashed border-dark bg-white px-5 py-3">
                  {e.logo ? (
                    <img src={e.logo} alt={e.nom} class="max-h-16 max-w-[10rem] object-contain" loading="lazy" />
                  ) : (
                    <span class="text-lg font-[500] leading-tight">{e.nom}</span>
                  )}
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        (fotos || fotosComunitat) && (
          <div class="mt-16 w-full max-w-4xl space-y-10">
            {fotos && fotos.length > 0 && (
              <figure class="mx-auto w-full max-w-md">
                <div class="overflow-hidden rounded-lg border-4 border-dark">
                  <Galeria imatges={fotos} alt={altEspai} aspect="aspect-[4/5]" />
                </div>
                <figcaption class="mt-2 text-sm italic opacity-70">{credit}</figcaption>
              </figure>
            )}
            {fotosComunitat && fotosComunitat.length > 0 && (
              <div class="mx-auto w-full max-w-2xl overflow-hidden rounded-lg border-4 border-dark">
                <Galeria imatges={fotosComunitat} alt={altEspai} aspect="aspect-[4/3]" />
              </div>
            )}
          </div>
        )
      }
    </section>
    {
      fotoAmple && (
        <figure class="w-full pb-20">
          <img
            src={fotoAmple}
            alt={altEspai}
            class="w-full object-cover"
            loading="lazy"
            decoding="async"
          />
          <figcaption class="page-padding mt-2 text-sm italic opacity-70">{credit}</figcaption>
        </figure>
      )
    }
  </main>
  <Footer />
</BaseLayout>


