---
// src/layouts/CursosLayout.astro
// v3: afegeix les tarifes i el calendari setmanal abans de les targetes
// de cursos. Bilingüe: els textos nous es trien segons l'idioma de la URL.
import Layout from './BaseLayout.astro'
import Footer from '../components/Footer.astro'
import Header from '../components/Header/Header.astro'
import { getLangFromUrl, removeLangFromSlug, useTranslatedPath } from '../utils'
import { getCollection } from 'astro:content'
import Highlights from '../components/Highlights.astro'
const { frontmatter } = Astro.props
const lang = getLangFromUrl(Astro.url)
const translatePath = useTranslatedPath(lang)
const mesInfo = lang === 'es' ? 'Más información' : 'Més informació'
const allTallers = await getCollection('cursos', ({ id }: { id: string }) => {
  return id.startsWith(lang)
})

// ── Textos de les seccions noves (ca/es) ───────────────────────────
const t =
  lang === 'es'
    ? {
        tarifesTitol: 'Precios',
        trimestre: 'El trimestre',
        trimestreTag: 'Curso entero',
        trimestreDetall: 'Enero – marzo · 9 o 10 sesiones',
        trimestreInclou: [
          'Todas las sesiones del trimestre',
          'Plaza garantizada todo el curso',
          'Se renueva cada 3 meses (a partir del 20 de marzo)',
          'Socias: precio especial',
        ],
        mensual: 'Mes a mes',
        mensualTag: 'Sin compromiso',
        mensualDetall: '4 sesiones · 20€/sesión',
        mensualInclou: [
          'Renovación mes a mes',
          'Prueba sin atarte todo el trimestre',
        ],
        botiga: 'Elige tu curso',
        sociesNota: '¿Eres socia del Club? Tienes un precio especial: avísanos antes de apuntarte y lo tramitamos en persona.',
        sociesLink: 'Descubre el Club',
        clubUrl: '/es/club',
        calendariTitol: 'El horario de la semana',
        kidsNota: 'Costura niños y jóvenes: 60€/mes · Extraescolares creativas: 55€/mes',
        dies: {
          dilluns: 'Lunes',
          dimarts: 'Martes',
          dimecres: 'Miércoles',
          dijous: 'Jueves',
        },
        horari: {
          kidsCostura: 'Iniciación costura kids y jóvenes',
          kidsCosturaDetall: 'De 8 a 15 años',
          kidsClub: 'Club Tallerets Kids',
          kidsClubDetall: 'De 5 a 11 años · dibujo, pintura, manualidades, inventos',
          iniciCostura: 'Iniciación a la costura',
          ganxet: 'Iniciación al ganchillo',
          iniciGanxet: 'Iniciación al ganchillo',
          iniciGanxetDetall: 'Grupo de mañana',
          dibuix: 'Iniciación a dibujo y pintura',
          dibuixDetall: 'Del 11/1 al 15/3 · 10 sesiones',
          iniciPunt: 'Iniciación al punto',
          iniciPuntDetall: 'De octubre a diciembre · aguja circular',
          costuraDetall: 'Del 12/1 al 16/3 · 10 sesiones',
          ganxetDetall: 'Del 13/1 al 17/3 · 10 sesiones',
          experimental: 'Bordado, costura y estampación',
          experimentalDetall: 'Del 21/1 al 18/3 · 9 sesiones',
          puntNota: 'Iniciación al punto: el próximo curso empieza en abril. Apúntate a la lista de espera.',
        }
      }
    : {
        tarifesTitol: 'Preus',
        trimestre: 'El trimestre',
        trimestreTag: 'Curs sencer',
        trimestreDetall: 'Gener – març · 9 o 10 sessions',
        trimestreInclou: [
          'Totes les sessions del trimestre',
          'Plaça garantida tot el curs',
          'Es renova cada 3 mesos (a partir del 20 de març)',
          'Sòcies: preu especial',
        ],
        mensual: 'Mes a mes',
        mensualTag: 'Sense compromís',
        mensualDetall: '4 sessions · 20€/sessió',
        mensualInclou: [
          'Renovació mes a mes',
          'Prova sense lligar-te tot el trimestre',
        ],
        botiga: 'Tria el teu curs',
        sociesNota: 'Ets sòcia del Club? Tens un preu especial: avisa\'ns abans d\'apuntar-te i t\'ho tramitem en persona.',
        sociesLink: 'Descobreix el Club',
        clubUrl: '/club',
        calendariTitol: "L'horari de la setmana",
        kidsNota: 'Costura kids i joves: 60€/mes · Extraescolars creatives: 55€/mes',
        dies: {
          dilluns: 'Dilluns',
          dimarts: 'Dimarts',
          dimecres: 'Dimecres',
          dijous: 'Dijous',
        },
        horari: {
          kidsCostura: 'Iniciació costura kids i joves',
          kidsCosturaDetall: 'De 8 a 15 anys',
          kidsClub: 'Club Tallerets Kids',
          kidsClubDetall: 'De 5 a 11 anys · dibuix, pintura, manualitats, invents',
          iniciCostura: 'Iniciació a la costura',
          ganxet: 'Iniciació al ganxet',
          iniciGanxet: 'Iniciació al ganxet',
          iniciGanxetDetall: 'Grup de matí',
          dibuix: 'Iniciació a dibuix i pintura',
          dibuixDetall: 'De l\'11/1 al 15/3 · 10 sessions',
          iniciPunt: 'Iniciació al punt',
          iniciPuntDetall: "D'octubre a desembre · agulla circular",
          costuraDetall: 'Del 12/1 al 16/3 · 10 sessions',
          ganxetDetall: 'Del 13/1 al 17/3 · 10 sessions',
          experimental: 'Brodat, costura i estampació',
          experimentalDetall: 'Del 21/1 al 18/3 · 9 sessions',
          puntNota: "Iniciació al punt: el proper curs comença a l'abril. Apunta't a la llista d'espera.",
        }
      }

// ── Calendari setmanal dels cursos ─────────────────────────────────
const setmana = [
  {
    dia: t.dies.dilluns,
    sessions: [
      { hora: '18:30–20:30', nom: t.horari.dibuix, detall: t.horari.dibuixDetall, tipus: 'inici' },
    ],
  },
  {
    dia: t.dies.dimarts,
    sessions: [
      { hora: '16:30–18:30', nom: t.horari.iniciCostura, detall: t.horari.costuraDetall, tipus: 'inici' },
      { hora: '18:30–20:30', nom: t.horari.iniciCostura, detall: t.horari.costuraDetall, tipus: 'inici' },
    ],
  },
  {
    dia: t.dies.dimecres,
    sessions: [
      { hora: '17:00–18:15', nom: t.horari.kidsCostura, detall: t.horari.kidsCosturaDetall, tipus: 'kids' },
      { hora: '17:00–18:30', nom: t.horari.kidsClub, detall: t.horari.kidsClubDetall, tipus: 'kids' },
      { hora: '18:30–20:30', nom: t.horari.ganxet, detall: t.horari.ganxetDetall, tipus: 'inici' },
    ],
  },
  {
    dia: t.dies.dijous,
    sessions: [
      { hora: '11:00–13:00', nom: t.horari.experimental, detall: t.horari.experimentalDetall, tipus: 'inici' },
      { hora: '18:30–20:30', nom: t.horari.experimental, detall: t.horari.experimentalDetall, tipus: 'inici' },
    ],
  },
]

const estilTipus: Record<string, string> = {
  kids: 'border-[#6F2118] bg-[#F2E9B1] text-[#6F2118]',
  inici: 'border-red-500',
}
---
<Layout
  title={frontmatter.title || 'Tallers'}
  description={frontmatter.desc || ''}
>
  <Header className="bg-soft text-dark relative" />
  <main>
    <h1
      class="pt-4 text-4xl md:text-6xl text-center md:leading-tight font-[500]"
    >
      {frontmatter.title}
      <span>
        <img
          width="48"
          height="48"
          class="w-12 inline text-sm"
          src="/icons/flor.svg"
          alt=""
        />
      </span>
    </h1>

    <!-- ── Targetes de cursos ──────────────────────────────── -->
    <section id="cursos" class="page-padding mx-auto mt-8 max-w-6xl">
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          allTallers.map((curs: any) => {
            const url =
              translatePath(`/${curs.collection}`) + removeLangFromSlug(curs.slug)
            return (
              <li>
                <a
                  href={url}
                  class="group flex h-full flex-col overflow-hidden rounded-xl border-2 border-dark bg-white transition-all hover:-translate-y-1 hover:border-red hover:text-dark"
                >
                  <img
                    src={curs.data.image.url}
                    alt={curs.data.image.alt}
                    class="aspect-[4/3] w-full border-b-2 border-dark object-cover"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="flex flex-1 flex-col p-5">
                    <h2 class="text-2xl font-[500] leading-tight">{curs.data.title}</h2>
                    <p class="mt-2 line-clamp-3 flex-1 text-sm opacity-80">{curs.data.desc}</p>
                    <span class="mt-4 font-mono text-xs uppercase tracking-widest text-red">
                      {mesInfo} →
                    </span>
                  </div>
                </a>
              </li>
            )
          })
        }
      </ul>
    </section>

    <!-- ── Tarifes ─────────────────────────────────────────── -->
    <section class="page-padding my-8 lg:my-12">
      <div class="mx-auto grid max-w-sm gap-6 items-stretch">
        <div class="relative flex flex-col rounded-xl border-2 border-red bg-white p-6 shadow-lg">
          <span class="absolute -top-3 left-1/2 -translate-x-1/2 -rotate-2 whitespace-nowrap bg-[#F2E9B1] px-3 py-1 font-mono text-xs uppercase tracking-wider text-[#6F2118]">
            {t.trimestreTag}
          </span>
          <h3 class="text-xl font-[500]">{t.trimestre}</h3>
          <p class="mt-2 text-5xl font-[300] text-red">220€</p>
          <p class="mt-1 font-mono text-xs uppercase tracking-wider opacity-70">
            {t.trimestreDetall}
          </p>
          <ul class="mt-4 flex-1 space-y-2 border-t-2 border-dashed border-soft pt-4 text-sm">
            {t.trimestreInclou.map((item) => (
              <li class="flex gap-2">
                <span class="text-red" aria-hidden="true">✿</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <p class="mx-auto mt-8 max-w-2xl text-center text-sm">
        {t.sociesNota}
        <a href={t.clubUrl} class="underline hover:text-red">{t.sociesLink}</a>
      </p>
      <div class="mt-6 text-center">
        <a href="#cursos" class="c-button inline-block border-dark">{t.botiga}</a>
      </div>
    </section>

    <!-- ── Calendari setmanal ──────────────────────────────── -->
    <section class="page-padding my-8 lg:my-12">
      <h2 class="text-3xl mb-10 md:text-4xl text-center md:leading-tight font-[500]">
        {t.calendariTitol}
        <span>
          <img
            width="40"
            height="40"
            class="w-10 inline text-sm"
            src="/icons/flor.svg"
            alt=""
          />
        </span>
      </h2>
      <div class="mx-auto grid max-w-5xl gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          setmana.map((d) => (
            <div>
              <h3 class="border-b-2 border-dark pb-2 text-center font-mono text-sm uppercase tracking-widest">
                {d.dia}
              </h3>
              <ul class="mt-3 space-y-3">
                {d.sessions.map((s) => (
                  <li class={`rounded-xl border-2 bg-white p-4 ${estilTipus[s.tipus]}`}>
                    <p class="font-mono text-xs tracking-wide">{s.hora}</p>
                    <p class="mt-1 font-[500] leading-snug">{s.nom}</p>
                    {s.detall && <p class="mt-1 text-xs opacity-80">{s.detall}</p>}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <p class="mx-auto mt-6 max-w-2xl text-center text-sm opacity-80">
        {t.kidsNota}
      </p>
      <p class="mx-auto mt-2 max-w-2xl text-center text-sm opacity-80">
        <a href="https://tally.so/r/PRzXYQ" class="underline hover:text-red">{t.horari.puntNota}</a>
      </p>
    </section>

    <section
      class="my-4 lg:my-12 flex flex-col items-center justify-center flex-wrap gap-x-16 gap-y-4"
    >
      <h2
        class="text-3xl mb-12 md:text-4xl text-center md:leading-tight font-[500]"
      >
        {frontmatter.other.subtitle}
        <span>
          <img
            width="48"
            height="48"
            class="w-12 inline text-sm"
            src="/icons/flor.svg"
            alt=""
          />
        </span>
      </h2>
      <Highlights />
    </section>
  </main>
  <hr />
  <Footer />
</Layout>
