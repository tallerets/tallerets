---
import Layout from './BaseLayout.astro'
import Footer from '../components/Footer.astro'
import Header from '../components/Header/Header.astro'
import TallerMiniCard from '../components/TallerMiniCard.astro'
import { getLangFromUrl } from '../utils'
import { getCollection } from 'astro:content'
import { NextEvents } from '../components/NextEvents'
import Highlights from '../components/Highlights.astro'
import { contacts } from '../data/contact'

const { frontmatter } = Astro.props
const lang = getLangFromUrl(Astro.url)
const allTallers = await getCollection('tallers', ({ id }: { id: string }) => {
  return id.startsWith(lang)
})
const events = await getCollection('events').then((events) =>
  events.sort((event) => {
    const date = new Date(event.data.date)
    return Date.now() - date.getTime()
  }),
)
const { email } = contacts
---

<Layout
  title={frontmatter.title || 'Tallers'}
  description={frontmatter.desc || ''}
>
  <Header className="bg-soft text-dark relative" />
  <main>
    <h1
      class="pt-4 text-4xl md:text-6xl md:text-center md:leading-tight font-[500] px-2"
    >
      {frontmatter.title}
      <span>
        <img
          width="48"
          height="48"
          class="w-12 inline text-sm"
          src="/icons/flor.svg"
          alt=""
        />
      </span>
    </h1>

    <p
      class="md:text-center md:text-lg mt-4 mb-6 md:mt-8 md:mb-10 max-w-[70ch] mx-auto px-2"
    >
      {frontmatter.desc}
    </p>

    <div id="zenamu-workshops" calendar-id="54e2a89a153ba46e3a14c5e3e4e3e034" class="max-w-4xl mx-auto px-2"></div>

    {
      frontmatter.links && frontmatter.links.length && (
        <div class="flex items-center justify-center mt-8 sm:mt-16 px-2 text-center">
          <a
            href={frontmatter.links[0].url}
            class="block border-2 px-4 py-3 rounded-lg text-xl sm:text-2xl font-bold hover:-rotate-3 transition-transform"
          >
            {frontmatter.links[0].text}
          </a>
        </div>
      )
    }
    <section class="page-padding my-12 lg:my-20 max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl text-center md:leading-tight font-[500] mb-4">
        {lang === 'es' ? 'Los talleres que hacemos' : 'Els tallers que fem'}
        <span>
          <img
            width="48"
            height="48"
            class="w-10 inline text-sm"
            src="/icons/flor.svg"
            alt=""
          />
        </span>
      </h2>
      <p class="md:text-center md:text-lg max-w-[60ch] mx-auto mb-8">
        {
          lang === 'es'
            ? 'Estos son los talleres que ofrecemos. Si quieres alguno para tu grupo, cumpleaños o empresa, te lo hacemos a medida.'
            : "Aquests són els tallers que oferim. Si en vols algun per al teu grup, aniversari o empresa, te'l fem a mida."
        }
      </p>
      <ul class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 md:gap-6">
        {allTallers.map((taller: any) => <TallerMiniCard taller={taller} />)}
        <TallerMiniCard />
      </ul>
    </section>
    <section
      class="my-4 lg:my-12 flex flex-col items-center justify-center flex-wrap gap-x-16 gap-y-4"
    >
      <h2
        class="text-3xl mb-12 md:text-4xl text-center md:leading-tight font-[500]"
      >
        {frontmatter.other.subtitle}
        <span>
          <img
            width="48"
            height="48"
            class="w-12 inline text-sm"
            src="/icons/flor.svg"
            alt=""
          />
        </span>
      </h2>
      <Highlights />
    </section>

    <hr />
    <Footer />
  </main>
    <script is:inline src="https://zenamu.com/calendar/workshops.js" crossorigin="anonymous"></script>
</Layout>
