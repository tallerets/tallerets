---
// Targeta compacta per al catàleg de tallers (pàgina /tallers).
// Si no es passa cap taller, mostra la targeta "Proposa el teu taller".
import { getLangFromUrl, removeLangFromSlug, useTranslatedPath } from '../utils'

type Props = {
  taller?: any
}
const { taller } = Astro.props

const lang = getLangFromUrl(Astro.url)
const translatePath = useTranslatedPath(lang)
const contactUrl = translatePath('/contacte')

const t =
  lang === 'es'
    ? {
        info: 'Más info',
        ask: 'Pídelo',
        proposeTitle: '¿No encuentras el taller que quieres?',
        proposeText: 'Cuéntanos qué te gustaría aprender y lo hacemos posible.',
        proposeBtn: 'Propón tu taller',
      }
    : {
        info: 'Més info',
        ask: "Demana'l",
        proposeTitle: 'No trobes el taller que vols?',
        proposeText: "Explica'ns què t'agradaria aprendre i ho fem possible.",
        proposeBtn: 'Proposa el teu taller',
      }

const infoUrl = taller
  ? translatePath(`/${taller.collection}`) + removeLangFromSlug(taller.slug)
  : ''
---

{
  taller ? (
    <li class="list-none flex flex-col bg-[#ffffff] rounded-xl border-2 border-dashed border-dark/20 p-3 hover:border-red transition-colors">
      <a href={infoUrl} class="block">
        <img
          class="w-full aspect-[4/3] object-cover rounded-lg"
          src={taller.data.image.url}
          alt={taller.data.image.alt}
          loading="lazy"
        />
      </a>
      <h3 class="mt-3 mb-4 text-lg md:text-xl font-[500] leading-snug">
        <a href={infoUrl} class="hover:text-red">
          {taller.data.title}
        </a>
      </h3>
      <div class="mt-auto flex flex-wrap gap-2">
        <a href={infoUrl} class="mini-btn">
          {t.info}
        </a>
        <a href={contactUrl} class="mini-btn destacat">
          {t.ask}
        </a>
      </div>
    </li>
  ) : (
    <li class="list-none flex flex-col bg-soft rounded-xl border-2 border-dashed border-red p-3">
      <a
        href={contactUrl}
        class="w-full aspect-[4/3] rounded-lg bg-red/10 flex items-center justify-center text-red text-7xl font-light hover:bg-red/20 transition-colors"
        aria-hidden="true"
        tabindex="-1"
      >
        +
      </a>
      <h3 class="mt-3 mb-2 text-lg md:text-xl font-[500] leading-snug">
        {t.proposeTitle}
      </h3>
      <p class="mb-4 text-base">{t.proposeText}</p>
      <div class="mt-auto flex">
        <a href={contactUrl} class="mini-btn destacat">
          {t.proposeBtn}
        </a>
      </div>
    </li>
  )
}

<style>
  .mini-btn {
    @apply inline-block border-2 border-dark rounded-lg px-3 py-1 text-base hover:border-red hover:text-red transition-colors;
  }
  .mini-btn.destacat {
    @apply bg-red text-soft border-red hover:bg-soft hover:text-red;
  }
</style>
