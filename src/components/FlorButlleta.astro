---
// Etiqueta petita i fixa al lateral dret amb la flor de Tallerets, que
// convida a apuntar-se a la butlleta. Apareix discretament després d'una
// estona al web i et segueix mentre navegues. Es pot amagar amb la creueta.
import { getLangFromUrl } from '../utils'

const lang = getLangFromUrl(Astro.url)
const t =
  lang === 'es'
    ? {
        curt: 'Nuevos talleres',
        llarg: '¡No te pierdas los talleres! Apúntate al boletín',
        url: '/es/newsletter',
        tancar: 'Ocultar',
      }
    : {
        curt: 'Nous tallers',
        llarg: "No et perdis els tallers! Apunta't a la butlleta",
        url: '/newsletter',
        tancar: 'Amagar',
      }
---

<div id="flor-butlleta" class="flor-etiqueta fixed right-0 top-1/2 z-40" hidden>
  <a
    href={t.url}
    class="group flex items-center gap-2 rounded-l-xl border-2 border-r-0 border-dark bg-[#F2E9B1] py-2 pl-2 pr-2 text-[#0D33AB] shadow-sm transition-all hover:bg-soft"
    title={t.llarg}
    aria-label={t.llarg}
  >
    <img src="/icons/flor.svg" alt="" class="h-7 w-7 shrink-0 transition-transform duration-500 group-hover:rotate-90" width="28" height="25" />
    <span class="text-sm font-[500] leading-tight">
      <span class="group-hover:hidden">{t.curt}</span>
      <span class="hidden max-w-[11rem] group-hover:inline">{t.llarg}</span>
    </span>
  </a>
  <button
    type="button"
    data-flor-tanca
    class="absolute -top-2 -left-2 hidden h-5 w-5 items-center justify-center rounded-full border border-dark bg-soft text-[10px] leading-none hover:border-red hover:text-red md:flex"
    aria-label={t.tancar}
  >
    ✕
  </button>
</div>

<style>
  .flor-etiqueta {
    transform: translate(110%, -50%);
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .flor-etiqueta.visible {
    transform: translate(0, -50%);
  }
  @media (prefers-reduced-motion: reduce) {
    .flor-etiqueta {
      transition: none;
    }
  }
</style>

<script>
  const ESPERA_MS = 15000
  const CLAU = 'tallerets-flor-butlleta'
  const DIES_AMAGADA = 7
  const el = document.getElementById('flor-butlleta')

  function llegeix(magatzem: Storage, clau: string): number {
    try {
      return Number(magatzem.getItem(clau)) || 0
    } catch {
      return 0
    }
  }
  function escriu(magatzem: Storage, clau: string, valor: number) {
    try {
      magatzem.setItem(clau, String(valor))
    } catch {}
  }

  const esButlleta = location.pathname.indexOf('newsletter') !== -1

  if (el && !esButlleta && llegeix(localStorage, CLAU) < Date.now()) {
    const inici = Date.now()
    const previ = llegeix(sessionStorage, CLAU + '-temps')
    window.addEventListener('pagehide', () =>
      escriu(sessionStorage, CLAU + '-temps', previ + Date.now() - inici),
    )
    setTimeout(
      () => {
        el.removeAttribute('hidden')
        requestAnimationFrame(() => requestAnimationFrame(() => el.classList.add('visible')))
      },
      Math.max(0, ESPERA_MS - previ),
    )
    el.querySelector('[data-flor-tanca]')?.addEventListener('click', () => {
      escriu(localStorage, CLAU, Date.now() + DIES_AMAGADA * 86400000)
      el.classList.remove('visible')
    })
  }
</script>
