---
// src/pages/botiga.astro
// La botiga de Tallerets: targeta regal, caixes de manualitats per emportar,
// calendari i samarretes. Mateix patró que club.astro: BaseLayout + Header +
// Footer, colors de tema (soft/dark/red) i Crema/Argila com a classes
// arbitràries.
//
// PER EDITAR: només cal tocar les dades d'aquí sota. Els href '#' s'han de
// substituir pels Payment Links de Stripe (https://buy.stripe.com/...).
// Imatges: van a public/img/. A `imatges` hi pots posar-ne una o més
// (amb més d'una, es poden passar). La ruta comença per /img/...
import Layout from '../layouts/BaseLayout.astro'
import Header from '../components/Header/Header.astro'
import Footer from '../components/Footer.astro'
import Galeria from '../components/Galeria.astro'

// ── Targeta regal ──────────────────────────────────────────────────
const imatgesTargeta = ['/img/targeta-regal-1.webp', '/img/targeta-regal-2.webp']
const targetes = [
  {
    nom: 'Targeta regal · Talleret',
    preu: '35€',
    descripcio: "L'import d'un talleret senzill. Vàlida per a qualsevol taller de Tallerets.",
    href: '#', // TODO: Payment Link targeta regal 35€
    destacada: false,
  },
  {
    nom: 'Targeta regal · Taller premium',
    preu: '60€',
    descripcio: "L'import d'un taller premium. Vàlida per a qualsevol taller de Tallerets.",
    href: '#', // TODO: Payment Link targeta regal 60€
    destacada: true,
  },
]

// ── Per emportar ───────────────────────────────────────────────────
// hrefRecollida: Payment Link sense enviament (recollida a Tallerets)
// hrefEnviament: Payment Link amb +10€ d'enviament i adreça (o null si no s'envia)
const perEmportar = [
  {
    nom: 'Caixa de manualitats',
    preu: '19€',
    descripcio:
      'Tot el que necessites per fer una manualitat a casa: materials, instruccions i ganes de passar-ho bé.',
    imatges: ['/img/caixa-producte.webp', '/img/caixa-0.webp', '/img/caixa-1.webp', '/img/caixa-2.webp', '/img/caixa-3.webp', '/img/caixa-4.webp', '/img/caixa-5.webp', '/img/caixa-6.webp', '/img/caixa-7.webp'],
    hrefRecollida: '#', // TODO: Payment Link caixa 19€ (recollida)
    hrefEnviament: '#' as string | null, // TODO: Payment Link caixa 19€ + 10€ enviament
    preventa: true,
  },
  {
    nom: 'Carta Club Postal',
    preu: '15€',
    descripcio:
      "Una carta del Club Postal, sense subscripció: la manualitat del mes amb materials i instruccions, i una il·lustració per pintar. Te l'enviem per correu.",
    imatges: ['/img/carta-postal-1.webp'],
    hrefRecollida: '#', // TODO: Payment Link carta Club Postal 15€ (amb adreça d'enviament)
    hrefEnviament: null as string | null,
    preventa: false,
    textBoto: 'Compra-la',
  },
]

// ── Calendari (va a la secció de samarretes) ───────────────────────
const calendari = {
  nom: 'Calendari Tallerets',
  preu: '15€',
  imatges: ['/img/calendari-1.webp', '/img/calendari-2.webp'],
  hrefRecollida: '#', // TODO: Payment Link calendari 15€ (recollida)
  hrefEnviament: '#', // TODO: Payment Link calendari 15€ + 10€ enviament
  preventa: true,
}

// ── Samarretes ─────────────────────────────────────────────────────
const preuSamarreta = '25€'
const samarretesPreventa = true
const samarretes = [
  {
    nom: 'El barri, per al barri',
    imatges: ['/img/samarreta-barri-1.webp'],
    href: '#', // TODO: Payment Link
  },
  {
    nom: 'Vermut',
    imatges: ['/img/samarreta-vermut-1.webp', '/img/samarreta-vermut-2.webp', '/img/samarreta-vermut-3.webp'],
    href: '#', // TODO: Payment Link
  },
  {
    nom: 'Manualitats',
    imatges: ['/img/samarreta-manualitats-1.webp'],
    href: '#', // TODO: Payment Link
  },
  {
    nom: 'Una casa per persona',
    imatges: ['/img/samarreta-casa-1.webp', '/img/samarreta-casa-2.webp'],
    href: '#', // TODO: Payment Link
  },
]

// Preventa: posa-ho a false (o esborra la línia de la data) quan ja hi hagi estoc.
const dataPreventa = 'Preventa · enviaments i recollides a partir de l’1 de desembre'

const etiquetaPreventa =
  'absolute top-3 left-3 z-[1] -rotate-3 bg-red px-3 py-1 font-mono text-xs uppercase tracking-wider text-soft'

const etiqueta =
  'absolute -top-3 left-1/2 -translate-x-1/2 -rotate-2 whitespace-nowrap bg-[#F2E9B1] px-3 py-1 font-mono text-xs uppercase tracking-wider text-[#6F2118]'
---

<Layout
  title="Botiga Tallerets: targetes regal, caixes de manualitats, calendari i samarretes"
  description="Regala creativitat: targetes regal, caixes de manualitats per emportar, el calendari i les samarretes de Tallerets, el teu espai creatiu a Sants."
>
  <Header className="bg-soft text-dark relative" />
  <main>
    <!-- ── Hero ─────────────────────────────────────────────── -->
    <section class="page-padding pt-4 text-center">
      <h1 class="text-4xl md:text-6xl md:leading-tight font-[500]">
        Botiga
        <span>
          <img width="48" height="48" class="w-12 inline text-sm" src="/icons/flor.svg" alt="" />
        </span>
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg md:text-xl">
        Per regalar o per regalar-te: una estona de crear amb les mans, a
        Tallerets o a casa teva.
      </p>
      <p class="mx-auto mt-4 max-w-2xl font-mono text-xs uppercase tracking-widest opacity-60">
        Les sòcies tenen descompte a la botiga
      </p>
    </section>

    <!-- ── Targeta regal ────────────────────────────────────── -->
    <section id="targeta-regal" class="page-padding my-8 lg:my-16">
      <h2 class="text-3xl md:text-4xl text-center md:leading-tight font-[500] mb-4">
        Targeta regal
        <span><img width="40" height="40" class="w-10 inline text-sm" src="/icons/flor.svg" alt="" /></span>
      </h2>
      <p class="mx-auto mb-10 max-w-2xl text-center">
        Regala temps per crear. La targeta es pot fer servir per a qualsevol
        taller: si costa més, es paga la diferència; si costa menys, la resta es
        guarda per a un altre taller.
      </p>
      <ul class="mx-auto grid max-w-3xl gap-6 sm:grid-cols-2 items-stretch">
        {targetes.map((t) => (
          <li
            class={`relative flex flex-col rounded-xl border-2 bg-white p-6 transition-all hover:-translate-y-1 ${
              t.destacada ? 'border-red shadow-lg' : 'border-dark'
            }`}
          >
            {t.destacada && <span class={etiqueta}>Premium</span>}
            <div class="mb-4 overflow-hidden rounded-lg border-2 border-dark">
              <Galeria imatges={imatgesTargeta} alt="Tarjeta regalo Tallerets" aspect="aspect-[1200/852]" />
            </div>
            <h3 class="text-xl font-[500]">{t.nom}</h3>
            <p class={`mt-2 text-5xl font-[300] ${t.destacada ? 'text-red' : ''}`}>{t.preu}</p>
            <p class="mt-4 flex-1 border-t-2 border-dashed border-soft pt-4 text-sm">{t.descripcio}</p>
            <a
              href={t.href}
              class={`c-button mt-6 block ${
                t.destacada ? 'border-red bg-red text-soft hover:bg-transparent' : 'border-dark'
              }`}
            >
              Regala-la
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- ── Per emportar ─────────────────────────────────────── -->
    <section id="per-emportar" class="page-padding my-8 lg:my-16">
      <h2 class="text-3xl md:text-4xl text-center md:leading-tight font-[500] mb-4">
        Per emportar
        <span><img width="40" height="40" class="w-10 inline text-sm" src="/icons/flor.svg" alt="" /></span>
      </h2>
      <p class="mx-auto mb-10 max-w-2xl text-center">
        La caixa la pots recollir a Tallerets (Sants) o te la fem arribar per 10€ més. La carta del Club Postal te l'enviem per correu.
      </p>
      <p class="mx-auto -mt-6 mb-10 max-w-2xl text-center font-mono text-xs uppercase tracking-widest text-red">Caixa en preventa · enviaments i recollides a partir de l’1 de desembre</p>
      <ul class="mx-auto grid max-w-3xl gap-6 sm:grid-cols-2 items-stretch">
        {perEmportar.map((p) => (
          <li class="relative flex flex-col overflow-hidden rounded-xl border-2 border-dark bg-white transition-all hover:-translate-y-1">
            {p.preventa && <span class={etiquetaPreventa}>Preventa</span>}
            <Galeria imatges={p.imatges} alt={p.nom} aspect="aspect-[4/3]" placeholderClass="bg-[#F2E9B1]" />
            <div class="flex flex-1 flex-col p-6">
              <h3 class="text-xl font-[500]">{p.nom}</h3>
              <p class="mt-2 text-4xl font-[300]">{p.preu}</p>
              <p class="mt-3 flex-1 border-t-2 border-dashed border-soft pt-3 text-sm">{p.descripcio}</p>
              <div class={`mt-6 grid gap-2 ${p.hrefEnviament ? 'grid-cols-2' : ''}`}>
                <a href={p.hrefRecollida} class="c-button block border-dark">{p.textBoto ?? 'Recollida'}</a>
                {p.hrefEnviament && (
                  <a href={p.hrefEnviament} class="c-button block border-dark">Enviament +10€</a>
                )}
              </div>
              {p.textBoto && (
                <p class="mt-3 text-center text-xs opacity-70">
                  Vols rebre-la cada mes? <a href="/club#quotes" class="underline">Fes-te sòcia del Club Postal</a>
                </p>
              )}
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- ── Samarretes ───────────────────────────────────────── -->
    <section id="samarretes" class="page-padding my-8 lg:my-16">
      <h2 class="text-3xl md:text-4xl text-center md:leading-tight font-[500] mb-4">
        Calendari i samarretes
        <span><img width="40" height="40" class="w-10 inline text-sm" src="/icons/flor.svg" alt="" /></span>
      </h2>
      <p class="mx-auto mb-10 max-w-2xl text-center">
        Porta Tallerets i el barri posats, i tingues tot l'any una mica de taller a casa.
      </p>
      <p class="mx-auto -mt-6 mb-10 max-w-2xl text-center font-mono text-xs uppercase tracking-widest text-red">{dataPreventa}</p>
      <ul class="mx-auto grid max-w-6xl gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 items-stretch">
        <li class="relative flex flex-col overflow-hidden rounded-xl border-2 border-red bg-white transition-all hover:-translate-y-1">
          {calendari.preventa && <span class={etiquetaPreventa}>Preventa</span>}
          <Galeria imatges={calendari.imatges} alt={calendari.nom} placeholder={calendari.nom} placeholderClass="bg-[#F2E9B1] text-[#6F2118]" />
          <div class="flex flex-1 flex-col p-5">
            <h3 class="flex-1 text-lg font-[500] leading-snug">{calendari.nom}</h3>
            <p class="mt-1 text-3xl font-[300]">{calendari.preu}</p>
            <div class="mt-4 grid gap-2">
              <a href={calendari.hrefRecollida} class="c-button block border-dark">Recollida</a>
              <a href={calendari.hrefEnviament} class="c-button block border-dark">Enviament +10€</a>
            </div>
          </div>
        </li>
        {samarretes.map((s) => (
          <li class="relative flex flex-col overflow-hidden rounded-xl border-2 border-dark bg-white transition-all hover:-translate-y-1">
            {samarretesPreventa && <span class={etiquetaPreventa}>Preventa</span>}
            <Galeria imatges={s.imatges} alt={`Samarreta ${s.nom}`} placeholder={`«${s.nom}»`} />
            <div class="flex flex-1 flex-col p-5">
              <h3 class="flex-1 text-lg font-[500] leading-snug">{s.nom}</h3>
              <p class="mt-1 text-3xl font-[300]">{preuSamarreta}</p>
              <a href={s.href} class="c-button mt-4 block border-dark">La vull</a>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- ── Info pràctica ────────────────────────────────────── -->
    <section class="page-padding my-8 lg:my-16 mx-auto max-w-2xl text-center">
      <p class="text-sm opacity-80">
        Pagament segur amb targeta. Qualsevol dubte sobre enviaments, recollides
        o regals, escriu-me a latallerets@gmail.com.
      </p>
      <a href="/contacte" class="c-button mt-6 inline-block border-dark">Contacta'm</a>
    </section>
  </main>
  <hr />
  <Footer />
</Layout>
