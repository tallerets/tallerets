---
import Footer from '../../components/Footer.astro'
import Header from '../../components/Header/Header.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'

const title = 'Tallerets'
const desc =
  'Todos los talleres monográficos y cursos de Tallerets en Sants, Barcelona. Consulta las fechas y reserva tu plaza.'
const calendarId = '54e2a89a153ba46e3a14c5e3e4e3e034'
---

<BaseLayout title={title} description={desc}>
  <Header />
  <main>
    <section class="page-padding mx-auto pb-20 pt-4 flex flex-col items-center">
      <h1 class="text-4xl md:text-6xl text-center md:leading-tight font-[500] max-w-[20ch] mt-0 mb-8 md:mb-12">
        {title}
        <span>
          <img width="48" height="48" class="w-12 inline text-sm" src="/icons/flor.svg" alt="" />
        </span>
      </h1>

      <p class="text-2xl md:text-xl max-w-[50ch] text-center mb-8">
        Aquí encontrarás todos los talleres y cursos que tenemos en marcha. Elige el que más te guste y reserva tu plaza directamente.
      </p>

      <nav class="flex flex-wrap justify-center gap-3 mb-12">
        <a href="#talleres" class="salt">Talleres de un día</a>
        <a href="#cursos" class="salt">Cursos</a>
        <a href="#club" class="salt">Club</a>
      </nav>

      <div class="w-full max-w-4xl flex flex-col gap-16">
        <div id="talleres" class="scroll-mt-24">
          <h2 class="text-3xl md:text-4xl font-[500] text-center mb-6">Talleres de un día</h2>
          <div id="zenamu-workshops" calendar-id={calendarId}></div>
        </div>

        <div id="cursos" class="scroll-mt-24 flex flex-col items-center text-center">
          <h2 class="text-3xl md:text-4xl font-[500] mb-6">Cursos</h2>
          <p class="text-2xl md:text-xl max-w-[50ch] mb-6">
            Los cursos son talleres semanales de varias sesiones para aprender una técnica paso a paso.
          </p>
          <a href="/es/cursos" class="salt">Ver los cursos</a>
        </div>

        <div id="club" class="scroll-mt-24 flex flex-col items-center text-center">
          <h2 class="text-3xl md:text-4xl font-[500] mb-6">Club de manualidades</h2>
          <p class="text-2xl md:text-xl max-w-[50ch] mb-6">
            Tu espacio creativo habitual: ven cada semana a crear con libertad, experimentar y compartir mesa con otras socias.
          </p>
          <div class="flex flex-wrap justify-center gap-3">
            <a href="/es/club" class="salt">Descubre el Club</a>
            <a href="/es/club" class="salt destacat">Hazte socia</a>
          </div>
        </div>
      </div>

      <p class="text-xl max-w-[50ch] text-center mt-16">
        ¿Buscas un taller para un grupo, un cumpleaños o tu empresa?
        <a href="/es/a-mida" class="underline hover:text-red">Hacemos talleres a medida</a>.
      </p>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script is:inline src="https://zenamu.com/calendar/workshops.js" crossorigin></script>

<style>
  a.salt {
    @apply block border-2 bg-soft rounded-lg text-center px-5 pb-[0.4rem] pt-[0.4rem] hover:-rotate-3 hover:border-red hover:text-red transition-transform;
  }
  a.salt.destacat {
    @apply bg-red text-soft border-red hover:bg-soft hover:text-red;
  }
</style>
