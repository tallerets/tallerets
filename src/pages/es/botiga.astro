---
// src/pages/es/botiga.astro
// Versión en castellano de la tienda. OJO: los imports llevan ../../
// PARA EDITAR: usa los MISMOS Payment Links, precios e imágenes que en la
// versión catalana (src/pages/botiga.astro).
import Layout from '../../layouts/BaseLayout.astro'
import Header from '../../components/Header/Header.astro'
import Footer from '../../components/Footer.astro'
import Galeria from '../../components/Galeria.astro'
import { caixes, caixaComu } from '../../data/caixes'

// ── Targeta regal ──────────────────────────────────────────────────
const imatgesTargeta = ['/img/targeta-regal-1.webp', '/img/targeta-regal-2.webp']
const targetes = [
  {
    nom: 'Tarjeta regalo · Talleret',
    preu: '35€',
    descripcio: 'El importe de un talleret sencillo. Válida para cualquier taller de Tallerets.',
    href: '#', // TODO: Payment Link targeta regal 35€
    destacada: false,
  },
  {
    nom: 'Tarjeta regalo · Taller premium',
    preu: '60€',
    descripcio: 'El importe de un taller premium. Válida para cualquier taller de Tallerets.',
    href: '#', // TODO: Payment Link targeta regal 60€
    destacada: true,
  },
]

// ── Per emportar ───────────────────────────────────────────────────
// hrefRecollida: Payment Link sense enviament (recollida a Tallerets)
// hrefEnviament: Payment Link amb +10€ d'enviament i adreça (o null si no s'envia)
const perEmportar = [
  {
    // Preu, fotos generals, enllaços i opcions: es canvien a src/data/caixes.ts
    nom: 'Caja de manualidades',
    preu: caixaComu.preu,
    descripcio:
      'Todo lo que necesitas para hacer una manualidad en casa: materiales, instrucciones y ganas de pasarlo bien.',
    imatges: caixaComu.imatgesGenerals,
    opcions: caixes.map((c) => ({ id: c.id, nom: c.nom.es, imatges: c.imatges })),
    hrefRecollida: caixaComu.hrefRecollida,
    hrefEnviament: caixaComu.hrefEnviament as string | null,
    preventa: caixaComu.preventa,
  },
  {
    nom: 'Carta Club Postal',
    preu: '15€',
    descripcio:
      'Una carta del Club Postal, sin suscripción: la manualidad del mes con materiales e instrucciones, y una ilustración para pintar. Te la enviamos por correo.',
    imatges: ['/img/carta-postal-1.webp'],
    hrefRecollida: '#', // TODO: Payment Link carta Club Postal 15€ (con dirección de envío)
    hrefEnviament: null as string | null,
    preventa: false,
    textBoto: 'Cómprala',
  },
]

// ── Calendario (va en la sección de camisetas) ─────────────────────
const calendari = {
  nom: 'Calendario Tallerets',
  preu: '15€',
  imatges: ['/img/calendari-1.webp', '/img/calendari-2.webp'],
  hrefRecollida: '#', // TODO: Payment Link calendari 15€ (recogida)
  hrefEnviament: '#', // TODO: Payment Link calendari 15€ + 10€ envío
  preventa: true,
}

// ── Samarretes ─────────────────────────────────────────────────────
const preuSamarreta = '25€'
const samarretesPreventa = true
const samarretes = [
  {
    nom: 'El barri, per al barri',
    imatges: ['/img/samarreta-barri-1.webp'],
    href: '#', // TODO: Payment Link
  },
  {
    nom: 'Vermut',
    imatges: ['/img/samarreta-vermut-1.webp', '/img/samarreta-vermut-2.webp', '/img/samarreta-vermut-3.webp'],
    href: '#', // TODO: Payment Link
  },
  {
    nom: 'Manualitats',
    imatges: ['/img/samarreta-manualitats-1.webp'],
    href: '#', // TODO: Payment Link
  },
  {
    nom: 'Una casa per persona',
    imatges: ['/img/samarreta-casa-1.webp', '/img/samarreta-casa-2.webp'],
    href: '#', // TODO: Payment Link
  },
]

// Preventa: posa-ho a false (o esborra la línia de la data) quan ja hi hagi estoc.
const dataPreventa = 'Preventa · envíos y recogidas a partir del 1 de diciembre'

const etiquetaPreventa =
  'absolute top-3 left-3 z-[1] -rotate-3 bg-red px-3 py-1 font-mono text-xs uppercase tracking-wider text-soft'

const etiqueta =
  'absolute -top-3 left-1/2 -translate-x-1/2 -rotate-2 whitespace-nowrap bg-[#F2E9B1] px-3 py-1 font-mono text-xs uppercase tracking-wider text-[#6F2118]'
---

<Layout
  title="Tienda Tallerets: tarjetas regalo, cajas de manualidades, calendario y camisetas"
  description="Regala creatividad: tarjetas regalo, cajas de manualidades para llevar, el calendario y las camisetas de Tallerets, tu espacio creativo en Sants."
>
  <Header className="bg-soft text-dark relative" />
  <main>
    <!-- ── Hero ─────────────────────────────────────────────── -->
    <section class="page-padding pt-4 text-center">
      <h1 class="text-4xl md:text-6xl md:leading-tight font-[500]">
        Tienda
        <span>
          <img width="48" height="48" class="w-12 inline text-sm" src="/icons/flor.svg" alt="" />
        </span>
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg md:text-xl">
        Para regalar o regalarte: un rato de crear con las manos, en
        Tallerets o en tu casa.
      </p>
    </section>

    <!-- ── Targeta regal ────────────────────────────────────── -->
    <section id="targeta-regal" class="page-padding my-8 lg:my-16">
      <h2 class="text-3xl md:text-4xl text-center md:leading-tight font-[500] mb-4">
        Tarjeta regalo
        <span><img width="40" height="40" class="w-10 inline text-sm" src="/icons/flor.svg" alt="" /></span>
      </h2>
      <p class="mx-auto mb-10 max-w-2xl text-center">
        Regala tiempo para crear. La tarjeta se puede usar para cualquier
        taller: si cuesta más, se paga la diferencia; si cuesta menos, el resto
        se guarda para otro taller.
      </p>
      <ul class="mx-auto grid max-w-3xl gap-6 sm:grid-cols-2 items-stretch">
        {targetes.map((t) => (
          <li
            class={`relative flex flex-col rounded-xl border-2 bg-white p-6 transition-all hover:-translate-y-1 ${
              t.destacada ? 'border-red shadow-lg' : 'border-dark'
            }`}
          >
            {t.destacada && <span class={etiqueta}>Premium</span>}
            <div class="mb-4 overflow-hidden rounded-lg border-2 border-dark">
              <Galeria imatges={imatgesTargeta} alt="Tarjeta regalo Tallerets" aspect="aspect-[1200/852]" />
            </div>
            <h3 class="text-xl font-[500]">{t.nom}</h3>
            <p class={`mt-2 text-5xl font-[300] ${t.destacada ? 'text-red' : ''}`}>{t.preu}</p>
            <p class="mt-4 flex-1 border-t-2 border-dashed border-soft pt-4 text-sm">{t.descripcio}</p>
            <a
              href={t.href}
              class={`c-button mt-6 block ${
                t.destacada ? 'border-red bg-red text-soft hover:bg-transparent' : 'border-dark'
              }`}
            >
              Regálala
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- ── Per emportar ─────────────────────────────────────── -->
    <section id="per-emportar" class="page-padding my-8 lg:my-16">
      <h2 class="text-3xl md:text-4xl text-center md:leading-tight font-[500] mb-4">
        Para llevar
        <span><img width="40" height="40" class="w-10 inline text-sm" src="/icons/flor.svg" alt="" /></span>
      </h2>
      <p class="mx-auto mb-10 max-w-2xl text-center">
        La caja la puedes recoger en Tallerets (Sants) o te la hacemos llegar por 10€ más. La carta del Club Postal te la enviamos por correo.
      </p>
      <p class="mx-auto -mt-6 mb-10 max-w-2xl text-center font-mono text-xs uppercase tracking-widest text-red">Caja en preventa · envíos y recogidas a partir del 1 de diciembre</p>
      <ul class="mx-auto grid max-w-3xl gap-6 sm:grid-cols-2 items-stretch">
        {perEmportar.map((p) => (
          <li class="relative flex flex-col overflow-hidden rounded-xl border-2 border-dark bg-white transition-all hover:-translate-y-1">
            {p.preventa && <span class={etiquetaPreventa}>Preventa</span>}
            {p.opcions ? (
              p.opcions.map((o, i) => (
                <div data-opcio-galeria={o.id} class={i === 0 ? '' : 'hidden'}>
                  <Galeria imatges={[...o.imatges, ...p.imatges]} alt={`${p.nom}: ${o.nom}`} aspect="aspect-[4/3]" placeholderClass="bg-[#F2E9B1]" />
                </div>
              ))
            ) : (
              <Galeria imatges={p.imatges} alt={p.nom} aspect="aspect-[4/3]" placeholderClass="bg-[#F2E9B1]" />
            )}
            <div class="flex flex-1 flex-col p-6">
              <h3 class="text-xl font-[500]">{p.nom}</h3>
              <p class="mt-2 text-4xl font-[300]">{p.preu}</p>
              <p class="mt-3 flex-1 border-t-2 border-dashed border-soft pt-3 text-sm">{p.descripcio}</p>
              {p.opcions && (
                <label class="mt-4 block">
                  <span class="font-mono text-xs uppercase tracking-wider opacity-70">Elige la caja</span>
                  <select data-opcions-caixa class="mt-1 block w-full rounded-lg border-2 border-dark bg-soft px-3 py-2 text-base">
                    {p.opcions.map((o) => <option value={o.id}>{o.nom}</option>)}
                  </select>
                  <span class="mt-1 block text-xs opacity-70">Al pagar, la caja que hayas elegido aquí quedará apuntada en el pedido.</span>
                  <span class="mt-1 block text-xs"><a href="/es/per-emportar" class="underline">Ver todas las cajas y qué trae cada una</a></span>
                </label>
              )}
              <div data-botons-caixa={p.opcions ? '' : undefined} class={`mt-6 grid gap-2 ${p.hrefEnviament ? 'grid-cols-2' : ''}`}>
                <a href={p.hrefRecollida} class="c-button block border-dark">{p.textBoto ?? 'Recogida'}</a>
                {p.hrefEnviament && (
                  <a href={p.hrefEnviament} class="c-button block border-dark">Envío +10€</a>
                )}
              </div>
              {p.textBoto && (
                <p class="mt-3 text-center text-xs opacity-70">
                  ¿Quieres recibirla cada mes? <a href="/es/club#quotes" class="underline">Hazte socia del Club Postal</a>
                </p>
              )}
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- ── Samarretes ───────────────────────────────────────── -->
    <section id="samarretes" class="page-padding my-8 lg:my-16">
      <h2 class="text-3xl md:text-4xl text-center md:leading-tight font-[500] mb-4">
        Calendario y camisetas
        <span><img width="40" height="40" class="w-10 inline text-sm" src="/icons/flor.svg" alt="" /></span>
      </h2>
      <p class="mx-auto mb-10 max-w-2xl text-center">
        Lleva Tallerets y el barrio puestos, y ten todo el año un poco de taller en casa.
      </p>
      <p class="mx-auto -mt-6 mb-10 max-w-2xl text-center font-mono text-xs uppercase tracking-widest text-red">{dataPreventa}</p>
      <ul class="mx-auto grid max-w-6xl gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 items-stretch">
        <li class="relative flex flex-col overflow-hidden rounded-xl border-2 border-red bg-white transition-all hover:-translate-y-1">
          {calendari.preventa && <span class={etiquetaPreventa}>Preventa</span>}
          <Galeria imatges={calendari.imatges} alt={calendari.nom} placeholder={calendari.nom} placeholderClass="bg-[#F2E9B1] text-[#6F2118]" />
          <div class="flex flex-1 flex-col p-5">
            <h3 class="flex-1 text-lg font-[500] leading-snug">{calendari.nom}</h3>
            <p class="mt-1 text-3xl font-[300]">{calendari.preu}</p>
            <div class="mt-4 grid gap-2">
              <a href={calendari.hrefRecollida} class="c-button block border-dark">Recogida</a>
              <a href={calendari.hrefEnviament} class="c-button block border-dark">Envío +10€</a>
            </div>
          </div>
        </li>
        {samarretes.map((s) => (
          <li class="relative flex flex-col overflow-hidden rounded-xl border-2 border-dark bg-white transition-all hover:-translate-y-1">
            {samarretesPreventa && <span class={etiquetaPreventa}>Preventa</span>}
            <Galeria imatges={s.imatges} alt={`Camiseta ${s.nom}`} placeholder={`«${s.nom}»`} />
            <div class="flex flex-1 flex-col p-5">
              <h3 class="flex-1 text-lg font-[500] leading-snug">{s.nom}</h3>
              <p class="mt-1 text-3xl font-[300]">{preuSamarreta}</p>
              <a href={s.href} class="c-button mt-4 block border-dark">La quiero</a>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- ── Info pràctica ────────────────────────────────────── -->
    <section class="page-padding my-8 lg:my-16 mx-auto max-w-2xl text-center">
      <p class="text-sm opacity-80">
        Pago seguro con tarjeta. Cualquier duda sobre envíos, recogidas
        o regalos, escríbeme a latallerets@gmail.com.
      </p>
      <a href="/es/contacte" class="c-button mt-6 inline-block border-dark">Contáctame</a>
    </section>
  </main>
  <hr />
  <Footer />
</Layout>

<script>
  // Desplegable de caixes: canvia les fotos i apunta la caixa triada a
  // l'enllaç de Stripe (client_reference_id, visible a cada pagament).
  document.querySelectorAll<HTMLSelectElement>('[data-opcions-caixa]').forEach((select) => {
    const targeta = select.closest('li')
    if (!targeta) return
    const botons = targeta.querySelectorAll<HTMLAnchorElement>('[data-botons-caixa] a')
    botons.forEach((a) => (a.dataset.base = a.getAttribute('href') ?? '#'))
    const aplica = () => {
      const id = select.value
      targeta.querySelectorAll<HTMLElement>('[data-opcio-galeria]').forEach((g) => {
        g.classList.toggle('hidden', g.dataset.opcioGaleria !== id)
      })
      botons.forEach((a) => {
        const base = a.dataset.base ?? '#'
        if (base.startsWith('http')) {
          const url = new URL(base)
          url.searchParams.set('client_reference_id', id)
          a.href = url.toString()
        }
      })
    }
    select.addEventListener('change', aplica)
    aplica()
  })
</script>
